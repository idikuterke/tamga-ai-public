# ============================================================
# Environment variable şablonu
# Render.com dashboard'da veya .env dosyasında (lokal geliştirme)
# aşağıdaki değişkenleri ayarlayın. .env ASLA commit edilmemeli
# (.gitignore'da *.env ve .env* pattern'leri tanımlı).
# ============================================================

# --- Zorunlu: Veritabanı bağlantısı ---
DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname

# --- Zorunlu: Uygulama secret'ları ---
JWT_SECRET=your-secret-key-here
ADMIN_API_KEY=your-admin-api-key-here
SECRET_KEY=change-me-to-a-64-char-random-hex-string-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
API_KEY_SECRET=change-me-to-another-random-hex-string-yyyyyyyyyyyyyyyyyyyyyyyy

# --- Opsiyonel: CORS ---
# Virgülle ayrılmış origin listesi. * KULLANMAYIN (sadece geliştirme aşamasında).
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Opsiyonel: Upload sınırı (MB) ---
MAX_UPLOAD_MB=10

# --- Opsiyonel: Kullanım logu ---
# JSON Lines formatında /var/log altına yazılır. Üretimde true.
LOG_USAGE=true

# --- Opsiyonel: Ortam ---
ENVIRONMENT=development

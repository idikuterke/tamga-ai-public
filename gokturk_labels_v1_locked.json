{
  "schema_version": "1.0-locked",
  "script": "old_turkic_orkhon",
  "label_set": "consensus_38_v1",
  "reading_direction": "rtl",
  "codepoint_authority": "Locked by Han against tamga.org (Tuğrul Çavdar) çevirici reading behavior + official Unicode Old Turkic block (v17.0, U+10C00-10C48)",
  "design_rules": {
    "class = letter identity (harf kimliği)": "one class per functionally distinct harf, confirmed by actual reading behavior in tamga.org çevirici, not by codepoint count alone",
    "core vs variation": "each class has ONE core codepoint (index anchor) + a sample_sources list of variation codepoints (Yenisey regional form, or sound-shift/hece variant) that render as the SAME class",
    "harmony pairs stay separate": "back (kalın) / front (ince) consonant pairs are distinct classes even when visually similar",
    "total_classes": 38
  },
  "known_exceptions": {
    "sh_nopolar": "does NOT follow the simple back/front pair pattern of B/D/G/K/L/N/R/S/T/Y. ESH (10C41/42) reads as BOTH aş and eş (context-dependent, non-polar). ASH (10C3F/40) reads ONLY as 'aş' and is folded in here as a variation, not a separate class — this was a live judgment call, revisit if tamga.org treats it as a distinct identity.",
    "c_nopolar / syllable_ic": "EC (10C32/33) is the context-dependent Ç (reads as aç or eç depending on neighboring letter). IC (10C31) is a SEPARATE, single-reading class (always 'iç'), not a variation of EC — confirmed by Han."
  },
  "changelog": [
    {
      "date": "2026-07-20",
      "change": "syllable_ok.sound: added 'ko','ku' (was ['ok','uk']). syllable_oek.sound: added 'kö','kü' (was ['ök','ük']). syllable_ik.sound already had both 'ık' and 'kı', unchanged.",
      "reason": "These hece damgaları (syllable glyphs) are bidirectionally readable (k+vowel or vowel+k, per Göktürkçe Yazım Kuralları Raporu I.3/III.3) but the sound lists only enumerated one reading direction. Discovered while building rules_engine.py's SpellingEngine (Latin->beklenen class_id dizisi motoru), confirmed by Han."
    }
  ],
